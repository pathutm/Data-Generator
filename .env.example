# ─── Supabase Configuration ──────────────────────────────────
# Supabase project URL (defaults to your existing project)
VITE_SUPABASE_URL=https://cdmzouvvhfahvkbihrph.supabase.co

# Supabase public/anon key (required to read/write dataset sources and history)
VITE_SUPABASE_ANON_KEY=

# ─── Data Generation Agent Webhook ────────────────────────────
# Production webhook URL for Data Collector Agent
VITE_DATA_COLLECTOR_WEBHOOK_URL=https://api.agents.snsihub.ai/webhook/cd87e46f-40fa-484d-8e2d-c1b212278a3f

# Test webhook URL for Data Collector Agent
VITE_DATA_COLLECTOR_WEBHOOK_TEST_URL=https://api.agents.snsihub.ai/webhook-test/cd87e46f-40fa-484d-8e2d-c1b212278a3f

# ─── Schema Generation Agent Webhook ──────────────────────────
# Production webhook URL for Schema Generation Agent
VITE_SCHEMA_WORKFLOW_WEBHOOK_URL=https://api.agents.snsihub.ai/webhook/8651917d-d75f-4b23-9939-5dad5b5f94af
VITE_SCHEMA_GENERATION_WEBHOOK_URL=https://api.agents.snsihub.ai/webhook/8651917d-d75f-4b23-9939-5dad5b5f94af

# Test webhook URL
VITE_SCHEMA_WORKFLOW_WEBHOOK_TEST_URL=https://api.agents.snsihub.ai/webhook-test/8651917d-d75f-4b23-9939-5dad5b5f94af

# Webhook request timeout in milliseconds (default: 600000 = 10 minutes)
VITE_WEBHOOK_TIMEOUT_MS=600000

# ─── Safety Limits ───────────────────────────────────────────
# Maximum archive size in MB (default: 200)
VITE_MAX_ARCHIVE_SIZE_MB=200

# Maximum total extracted size in MB (default: 500)
VITE_MAX_EXTRACTED_SIZE_MB=500

# Maximum number of extracted files per archive (default: 500)
VITE_MAX_EXTRACTED_FILES=500

# Maximum compression ratio before ZIP-bomb detection (default: 100)
VITE_MAX_COMPRESSION_RATIO=100

# Maximum number of ZIP files that can be uploaded (default: 10)
VITE_MAX_UPLOAD_FILES=10
